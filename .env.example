# ============================================================
# Pede Aqui — Variáveis de ambiente
# Copie este arquivo para .env (bot/Electron) e .env.local (frontend Vite)
# e preencha com as credenciais do Supabase.
# ============================================================

# --- Frontend (Vite) — precisa do prefixo VITE_ ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Imagens no Cloudflare R2 (worker-imagens). Sem isso, o app usa o armazenamento do Supabase.
VITE_IMAGENS_UPLOAD_URL=
VITE_IMAGENS_CDN_URL=

# Aviso de pedido novo com a tela bloqueada (Web Push). A chave privada e o segredo vão só na Vercel.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SEGREDO=

# Para testar local numa loja só (o programa instalado e o localhost não têm loja fixa)
VITE_LOJA_DEV=

# --- Bot WhatsApp / Electron (servidor.ts e main.js) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORE_ID=
OPENAI_API_KEY=
BTZAP_TOKEN=
BTZAP_INSTANCE_NAME=PedeAqui
PHONE_ID=pedeaki
INSTANCE_NUMBER=
APP_URL=
